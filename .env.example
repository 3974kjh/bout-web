# Supabase (https://supabase.com/dashboard → Project Settings → API)
# SvelteKit public env — 브라우저에 노출됩니다. anon 키만 사용하세요.
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 배포 URL — Vite 빌드에 박히므로 Cloudflare Pages → Settings → Environment variables
# (Production) 에도 동일하게 넣고, 변경 후 재배포해야 합니다.
# PUBLIC_SITE_URL=https://bout-web.pages.dev
#
# Supabase 대시보드 필수 설정 (로그인 후 localhost 로 가는 경우 거의 여기 때문):
# Authentication → URL Configuration → Site URL = https://bout-web.pages.dev
# Redirect URLs 에 https://bout-web.pages.dev/auth/callback 추가 (로컬은 http://127.0.0.1:5173/auth/callback 등)
